{
    "name": "slash197/reges-laravel",
    "description": "Laravel bridge for slash197/reges, the PHP client for the REGES Online API",
    "type": "library",
    "license": "MIT",
    "keywords": ["reges", "reges-online", "revisal", "inspectia-muncii", "romania", "laravel"],
    "homepage": "https://github.com/slash197/reges-laravel",
    "authors": [
        {
            "name": "Levi Szocs",
            "email": "levi.szocs@codescape.ro"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/log": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "psr/http-client": "^1.0",
        "psr/log": "^2.0 || ^3.0",
        "slash197/reges": "^0.1"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "slash197\\Reges\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "slash197\\Reges\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "slash197\\Reges\\Laravel\\RegesServiceProvider"
            ],
            "aliases": {
                "Reges": "slash197\\Reges\\Laravel\\Facades\\Reges"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
